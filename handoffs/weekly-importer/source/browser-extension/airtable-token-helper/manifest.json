{
  "manifest_version": 3,
  "name": "AutoPM · Airtable 授权助手",
  "version": "1.0.0",
  "description": "选择 Airtable 权限，完成 OAuth 授权或 PAT 配置指引，验证连接并导出 AutoPM JSON。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "storage",
    "identity",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.airtable.com/*",
    "https://airtable.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 Airtable 授权助手"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}